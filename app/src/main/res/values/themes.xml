<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MatchShell" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page_background</item>
    </style>

    <!-- Module cards: unified card surface with consistent radius and press state -->
    <style name="ModuleCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/module_card_background</item><item name="android:clickable">true</item><item name="android:focusable">true</item>
        <item name="android:elevation">2dp</item><item name="android:gravity">top</item><item name="android:orientation">horizontal</item><item name="android:padding">20dp</item>
    </style>
    <style name="ModuleIcon">
        <item name="android:layout_width">44dp</item><item name="android:layout_height">44dp</item><item name="android:background">@drawable/module_icon_background</item><item name="android:contentDescription">@null</item><item name="android:padding">10dp</item>
    </style>
    <style name="ModuleBody">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginStart">16dp</item><item name="android:layout_weight">1</item><item name="android:orientation">vertical</item>
    </style>
    <style name="ModuleTitle"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item></style>
    <style name="ModuleDescription"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">4dp</item><item name="android:lineSpacingExtra">3dp</item><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">14sp</item></style>

    <!-- Meta pills: brand tint for emphasis, muted tint for secondary -->
    <style name="ModuleMeta"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">10dp</item><item name="android:background">@drawable/meta_pill_background</item><item name="android:paddingStart">10dp</item><item name="android:paddingTop">4dp</item><item name="android:paddingEnd">10dp</item><item name="android:paddingBottom">4dp</item><item name="android:textColor">@color/brand</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item></style>
    <style name="ModuleMetaMuted" parent="ModuleMeta"><item name="android:textColor">@color/text_tertiary</item></style>
    <style name="ModuleArrow"><item name="android:layout_width">20dp</item><item name="android:layout_height">20dp</item><item name="android:layout_marginStart">8dp</item><item name="android:contentDescription">@null</item><item name="android:src">@drawable/ic_chevron_right</item></style>

    <!-- Primary action button: filled brand surface -->
    <style name="ActionButtonPrimary">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary action button: card surface, used for cancel / low-emphasis actions -->
    <style name="ActionButtonSecondary">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/button_secondary_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Pill button used in header areas (e.g. "前往文件池") -->
    <style name="PillButton">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/file_pool_pill_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">14dp</item><item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- File pool grid item card -->
    <style name="FilePoolItemCard">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/file_pool_item_background</item>
        <item name="android:padding">8dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <!--
      弹窗统一圆角（长期规范，2026-09-11 起）。
      平台 AlertDialog 默认画的是直角背景，这里把窗口背景换成 22dp 圆角白面。
      调用侧一律用 AlertDialog.Builder(context, R.style.Theme_MatchShell_Dialog)，
      并在 show() 之后调 Dialog.roundCorners() 兜底（平台某些版本会在内部分区再画一层背景）。
    -->
    <style name="Theme.MatchShell.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <!--
      文件池贴底操作条：管理态 / 选择器态 / 重命名态共用同一高度，
      切语境时几何不变（用户明确要求三种情况的占用高度相同）。

      ⚠️ 条本身**不加背景**：只让里面的圆角按钮自己成形。
      早先给它铺了一层 card_background，结果是一条通栏的直角色块，
      和全站圆角语言打架（用户报过"外部还有直角框"）。

      左右内边距配 4 + 14：每个按钮自带 10dp marginStart，
      这样第一个按钮距边 14dp、按钮间距 10dp，且不管换哪一组按钮都成立。
    -->
    <style name="FilePoolActionBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="FilePoolActionBarButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@drawable/button_secondary_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FilePoolActionBarButton.Danger">
        <item name="android:background">@drawable/button_danger_background</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="FilePoolActionBarButton.Primary">
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_weight">1.6</item>
    </style>
</resources>
